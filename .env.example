VITE_FIREBASE_CONFIG='{"apiKey":"YOUR_API_KEY","authDomain":"YOUR_PROJECT.firebaseapp.com","projectId":"YOUR_PROJECT_ID","storageBucket":"YOUR_PROJECT.appspot.com","messagingSenderId":"YOUR_SENDER_ID","appId":"YOUR_APP_ID"}'
VITE_APP_ID='home-repair-app'
VITE_INITIAL_AUTH_TOKEN=''

# ── Resend (email notifications) ─────────────────────────────────────────────
# Required: your Resend API key (https://resend.com/api-keys)
RESEND_API_KEY='re_YOUR_API_KEY'

# Optional: override sender once your domain is verified in Resend.
# Defaults to the Resend sandbox address until then.
RESEND_FROM_EMAIL='First Call Maintenance <notifications@firstcallmaintenance.biz>'

# ── App URL (used in email notification buttons) ──────────────────────────────
# Set this to your stable production URL in Vercel environment variables.
# Change to https://firstcallmaintenance.biz once that domain is fully working.
APP_URL='https://home-repair-request.vercel.app'
